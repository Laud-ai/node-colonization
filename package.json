    "sim:growth": "tsx src/growthProbe.ts",
    "sim:clocks": "tsx src/clockProbe.ts",
    "snapshot": "node scripts/snapshot.mjs",
    "smoke": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "three": "^0.170.0"
  }
